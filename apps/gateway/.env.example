# Tool Gateway — the single door for external/internal tool calls.
# Bun auto-loads this file (cwd is this dir when run via `bun run dev:gateway`).
# Copy to `.env` and fill in. Generate the two secrets with: openssl rand -hex 32

# Master secret for encrypting connector credentials at rest (AES-256-GCM,
# key = SHA-256 of this). Use a strong random value; changing it makes any
# already-stored credential undecryptable.
CREDENTIAL_VAULT_KEY=

# Shared internal secret with the control plane, sent as the x-admin-token header.
INTERNAL_API_TOKEN=

# Optional Composio project key. A vault credential at provider=composio/key=api_key takes precedence.
COMPOSIO_API_KEY=

# Optional stable shared Composio user id (default: shared).
# COMPOSIO_USER_ID=shared

# Port the gateway listens on (control-plane's TOOL_GATEWAY_URL must point here).
PORT=4100

# Optional — web app URL to return to after an OAuth connect (defaults to the dev web server).
# WEB_APP_URL=http://localhost:3000

# Optional — defaults to the shared repo-root DB:
# DATABASE_PATH=data/platform.db
