# Control plane — Slack assistant + web channel/API + session engine.
# Bun auto-loads this file (cwd is this dir when run via `bun run --filter`).
# Copy to `.env` and fill in.

# Slack connections are created in the web UI (Connections page) and stored
# encrypted in SQLite — no Slack env vars here.

# Master secret for encrypting Slack connection tokens at rest (AES-256-GCM).
# Required. Must match the gateway's GILLY_VAULT_KEY (same DB). openssl rand -hex 32
GILLY_VAULT_KEY=

# Shared internal secret with the gateway. Never expose it to the browser.
GILLY_ADMIN_TOKEN=

# Port for the web channel / management API the UI calls.
WEB_PORT=4000

# Unified Claude/OpenAI harness endpoint (AgentCore contract).
HARNESS_URL=http://localhost:8080

# Tooling gateway endpoint — set this to enable per-run token minting. Must match
# apps/gateway's PORT. Leave blank to run without the gateway.
GILLY_GATEWAY_URL=http://localhost:4100

# Maximum time to wait for gateway tool discovery during legacy connector migration.
GILLY_GATEWAY_DISCOVERY_TIMEOUT_MS=10000

# Optional — defaults resolve against the repo root:
# AGENTS_DIR=config/agents
# Agents that ship with the product (e.g. agent-builder). Loaded into memory at boot and never
# written to the DB, so they stay out of the agents directory and only change through code.
# BUILTIN_AGENTS_DIR=config/builtin-agents
# DATABASE_PATH=data/gilly.db
