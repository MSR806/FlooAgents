# Unified harness - drives Claude and OpenAI agent loops behind one HTTP server.
# Bun auto-loads this file. Copy to `.env` and fill in.

# Anthropic API key the SDK uses to drive the loop.
ANTHROPIC_API_KEY=

# OpenAI API key used by the Codex SDK.
OPENAI_API_KEY=

# Optional — port for the AgentCore contract (/invocations, /ping). Default 8080.
# PORT=8080

# Optional - defaults are anchored to the repository root.
# WORKSPACES_DIR=data/workspaces
# CODEX_STATE_DIR=data/codex
