{
  "name": "floo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MSR806/FlooAgents.git"
  },
  "bugs": {
    "url": "https://github.com/MSR806/FlooAgents/issues"
  },
  "homepage": "https://github.com/MSR806/FlooAgents#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test apps packages",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev:harness": "bun run --filter '@floo/harness' dev",
    "dev:control-plane": "bun run --filter '@floo/control-plane' dev",
    "dev:gateway": "bun run --filter '@floo/gateway' dev",
    "dev:web": "bun run --filter '@floo/web' dev"
  },
  "dependencies": {
    "@floo/gateway-client": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  }
}
