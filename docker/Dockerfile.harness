# Unified Claude/OpenAI harness implementing the AgentCore contract on :8080.
# Same image runs locally and (later) inside AWS Bedrock AgentCore unchanged.
# Pinned to match the lockfile's bun so --frozen-lockfile stays stable.
FROM oven/bun:1.3.5 AS base
WORKDIR /app

# Copy the whole workspace so the frozen lockfile resolves every member.
COPY package.json bun.lock ./
COPY packages ./packages
COPY apps ./apps
RUN bun install --frozen-lockfile

# Constructing the client resolves the SDK's bundled native Linux Codex binary.
RUN bun --cwd apps/harness -e 'import { Codex } from "@openai/codex-sdk"; new Codex();'

RUN mkdir -p /data/workspaces /data/codex && chown -R bun:bun /data/workspaces /data/codex

EXPOSE 8080
USER bun
CMD ["bun", "run", "--filter", "@gilly/harness", "start"]
