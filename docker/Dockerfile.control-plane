# Floo Agents control plane — Slack (Socket Mode) listener + session/run engine.
# Pinned to match the lockfile's bun so --frozen-lockfile stays stable.
FROM oven/bun:1.3.5 AS base
WORKDIR /app

# Copy the whole workspace so the frozen lockfile resolves every member.
COPY package.json bun.lock ./
COPY packages ./packages
COPY apps ./apps
RUN bun install --frozen-lockfile

# Agent/skill JSON config is mounted at runtime; SQLite store lives on a volume.
CMD ["bun", "run", "--filter", "@agent-platform/control-plane", "start"]
